# Configuration for `docker compose up`. Copy this file to .env and fill in
# what you need; everything is optional and has a working default.
#
# This is the ONLY file Docker reads. (apps/api/.env and apps/web/.env are for
# running without Docker.) Full reference: docs/configuration.md
#
# After changing it: docker compose up -d --build

# --- Site --------------------------------------------------------------------
# The address people open in their browser: scheme + host (+ port), no path.
# Login cookies, emailed links and the payment return page all follow it.
PUBLIC_URL=http://localhost:8080
# Other addresses the same site is opened from (a tunnel, a second domain),
# comma separated. Example: https://abc.trycloudflare.com
ALLOWED_ORIGINS=
# Port published on this machine.
WEB_PORT=8080
# Language a first-time visitor sees, and of emails when the guest's
# language is unknown: vi or en. (Rebuild after changing.)
DEFAULT_LANGUAGE=vi

# --- Property ----------------------------------------------------------------
# Starting values only. The admin page "Cơ sở lưu trú" (/admin/property)
# stores these in the database, and what is saved there wins over this file
# without a rebuild. Used on the site, in emails and on the PDF confirmation.
APP_NAME=LuxeStay
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=
CHECK_IN_TIME=14:00
CHECK_OUT_TIME=12:00

# --- Security ----------------------------------------------------------------
# Password of the bundled PostgreSQL. Choose a strong one BEFORE first start.
DB_PASSWORD=luxestay
# Leave empty to have one generated and stored on first start.
JWT_SECRET=
# true once the site is only reached over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Proxies in front of the API. 1 = just the bundled nginx. Add one for each
# reverse proxy or tunnel in front of it (Cloudflare Tunnel, Caddy: 2).
TRUST_PROXY_HOPS=1

# --- Bookings ----------------------------------------------------------------
# Timezone of the property: decides what "today" is.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Minutes an unpaid booking holds its room.
PENDING_BOOKING_TTL_MINUTES=30
# A paid booking can be cancelled by the guest until this many days before
# check-in. (Also a starting value: /admin/property overrides it.)
FREE_CANCELLATION_DAYS=3

# --- Sample data -------------------------------------------------------------
# Create the sample admin, guest, rooms and bookings on start (skips what exists).
SEED_ON_START=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (booking emails, "forgot password", refund alerts) ----------------
# Without SMTP_HOST, SMTP_PORT and SMTP_FROM no email is sent; bookings still work.
# SMTP_USER/SMTP_PASS are only needed if your mail server asks for them.
# To try it without a real mailbox: docker compose --profile mail up -d
# with SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_FROM=no-reply@example.com,
# then read the emails at http://localhost:8025 (MAILPIT_PORT to change).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAILPIT_PORT=8025

# --- Uploaded images ---------------------------------------------------------
# local = a Docker volume on this machine (default). s3 = an S3-compatible
# bucket (AWS S3, Cloudflare R2, MinIO, ...); the bucket must allow public read.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Empty for AWS. For R2/MinIO: the service's API address.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket, no trailing slash. Images are served from it.
S3_PUBLIC_URL=
# true for MinIO and most self-hosted servers.
S3_FORCE_PATH_STYLE=

# --- VNPay (on when the code and secret are both set) ------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Empty = sandbox (https://sandbox.vnpayment.vn/paymentv2/vpcpay.html).
VNPAY_PAY_URL=
# Empty = PUBLIC_URL/payment/result. Only set it to send guests elsewhere.
VNPAY_RETURN_URL=

# --- MoMo (BETA, off unless MOMO_ENABLED=true) -------------------------------
MOMO_ENABLED=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=
# Empty = PUBLIC_URL/payment/result.
MOMO_RETURN_URL=
# Must be reachable from the Internet: <public address>/api/payments/momo/ipn
MOMO_IPN_URL=

# --- Google sign-in (off unless both halves are filled in) -------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Web half, baked into the web image at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
