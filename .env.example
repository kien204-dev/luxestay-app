# Optional settings for `docker compose up`. Copy to .env to change them.
# (For running without Docker, see apps/api/.env.example and apps/web/.env.example.)

# Address people use to open the site. Must match exactly (scheme + host + port).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Product name shown in the UI, emails and reports.
APP_NAME=LuxeStay

# Password of the bundled PostgreSQL container (not exposed outside Docker).
DB_PASSWORD=luxestay

# Leave empty to have one generated and stored on first start.
JWT_SECRET=

# Create the sample admin, guest, rooms and bookings on start (skips what exists).
SEED_ON_START=true

# Set to true once the site is served over HTTPS.
AUTH_COOKIE_SECURE=false
