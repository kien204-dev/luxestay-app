# Configuration for `docker compose up`. Copy this file to .env and fill in
# what you need; everything is optional and has a working default.
#
# This is the ONLY file Docker reads. (apps/api/.env and apps/web/.env are for
# running without Docker.) Full reference: docs/configuration.md
#
# After changing it: docker compose up -d --build

# --- Site --------------------------------------------------------------------
# The address people open in their browser: scheme + host (+ port), no path.
# Login cookies, emailed links and the payment return page all follow it.
PUBLIC_URL=http://localhost:8080
# Other addresses the same site is opened from (a tunnel, a second domain),
# comma separated. Example: https://abc.trycloudflare.com
ALLOWED_ORIGINS=
# Port published on this machine.
WEB_PORT=8080
# Product name in the UI, emails and reports. (Rebuild after changing.)
APP_NAME=LuxeStay

# --- Security ----------------------------------------------------------------
# Password of the bundled PostgreSQL. Choose a strong one BEFORE first start.
DB_PASSWORD=luxestay
# Leave empty to have one generated and stored on first start.
JWT_SECRET=
# true once the site is only reached over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Proxies in front of the API. 1 = just the bundled nginx. Add one for each
# reverse proxy or tunnel in front of it (Cloudflare Tunnel, Caddy: 2).
TRUST_PROXY_HOPS=1

# --- Bookings ----------------------------------------------------------------
# Timezone of the property: decides what "today" is.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Minutes an unpaid booking holds its room.
PENDING_BOOKING_TTL_MINUTES=30
# A paid booking can be cancelled by the guest until this many days before check-in.
FREE_CANCELLATION_DAYS=3

# --- Sample data -------------------------------------------------------------
# Create the sample admin, guest, rooms and bookings on start (skips what exists).
SEED_ON_START=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (needed for "forgot password" and refund alerts) ------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- VNPay (on when the code and secret are both set) ------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Empty = sandbox (https://sandbox.vnpayment.vn/paymentv2/vpcpay.html).
VNPAY_PAY_URL=
# Empty = PUBLIC_URL/payment/result. Only set it to send guests elsewhere.
VNPAY_RETURN_URL=

# --- MoMo (BETA, off unless MOMO_ENABLED=true) -------------------------------
MOMO_ENABLED=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=
# Empty = PUBLIC_URL/payment/result.
MOMO_RETURN_URL=
# Must be reachable from the Internet: <public address>/api/payments/momo/ipn
MOMO_IPN_URL=

# --- Google sign-in (off unless both halves are filled in) -------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Web half, baked into the web image at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
