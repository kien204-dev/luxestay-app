# Copy to apps/web/.env for running the web app without Docker.

# Where the API lives.
VITE_API_URL=http://localhost:3001/api

# Product name shown in the UI (also the tab title and the favicon's letter)
# until the API answers; the name saved on /admin/property replaces it.
VITE_APP_NAME=LuxeStay

# Language a first-time visitor sees: vi or en.
VITE_DEFAULT_LANGUAGE=vi

# Contact details shown in the site footer until the API answers (the ones
# saved on /admin/property replace them); empty ones are left out.
# VITE_CONTACT_PHONE=
# VITE_CONTACT_EMAIL=
# VITE_CONTACT_ADDRESS=

# Google sign-in (optional). Leave these out and the button stays disabled;
# email/password sign-in works without them.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
