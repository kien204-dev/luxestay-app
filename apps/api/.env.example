# Copy to apps/api/.env for running the API WITHOUT Docker (npm run dev).
# Docker does not read this file: it uses the .env in the repository root.
# Full reference: docs/configuration.md
# Required: the DB_* block and JWT_SECRET. Everything else is optional.

# --- Server -----------------------------------------------------------------
PORT=3001
# Address of the web app. Used for CORS, the CSRF origin check and email links.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Further addresses the web app is opened from, comma separated.
# ALLOWED_ORIGINS=https://abc.trycloudflare.com
# Language of emails when the guest's language is unknown: vi or en.
# DEFAULT_LANGUAGE=vi

# --- Property ---------------------------------------------------------------
# Starting values only: what the admin saves on /admin/property is stored in
# the database and wins over these. Used in emails, the PDF confirmation and
# the public site.
APP_NAME=LuxeStay
# CONTACT_PHONE=
# CONTACT_EMAIL=
# CONTACT_ADDRESS=
# CHECK_IN_TIME=14:00
# CHECK_OUT_TIME=12:00
# Number of reverse proxies in front of the API (0 = none). Use 1 on Render,
# behind nginx, etc. so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=0
# Requests per minute allowed from one IP address across the whole API.
# API_RATE_LIMIT_PER_MINUTE=300

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=luxestay
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password
# true = TLS with certificate check, no-verify = TLS without it, false = off.
# Left unset: on for *.neon.tech hosts, off otherwise.
# DB_SSL=false

# --- Authentication ---------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL=1d
AUTH_COOKIE_NAME=luxestay_session
AUTH_COOKIE_MAX_AGE_MS=86400000
# Local http: false + lax. Web and API on different HTTPS sites: true + none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
RESET_TOKEN_TTL_MINUTES=15

# --- Bookings ---------------------------------------------------------------
# Timezone of the property. Decides what "today" is for bookings.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# A paid booking can be cancelled by the guest (and refunded) until this many
# days before check-in. Unpaid bookings can always be cancelled.
# (Also a starting value: /admin/property overrides it.)
FREE_CANCELLATION_DAYS=3
# Unpaid "pending" bookings are cancelled automatically after this long.
PENDING_BOOKING_TTL_MINUTES=30

# --- Seed (npm run db:seed) -------------------------------------------------
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# Lets "npm run db:reset" wipe a database that is not on this machine.
# ALLOW_DB_RESET=false
# Public demo only (docs/demo.md): sample sign-ins shown, important changes blocked.
# DEMO_MODE=false
# DEMO_RESET_INTERVAL_HOURS=24

# --- Email (optional: booking emails, "forgot password", refund alerts) -----
# Sent only when SMTP_HOST, SMTP_PORT and SMTP_FROM are set; bookings work without it.
# SMTP_USER/SMTP_PASS are only needed if the mail server asks for them.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="LuxeStay <no-reply@example.com>"

# --- Uploaded images --------------------------------------------------------
# local = apps/api/uploads (default). s3 = an S3-compatible bucket (AWS S3,
# Cloudflare R2, MinIO, ...); the bucket must allow public read.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# Empty for AWS. For R2/MinIO: the service's API address.
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public address of the bucket, no trailing slash.
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false

# --- VNPay (optional; sandbox: https://sandbox.vnpayment.vn) ----------------
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional: defaults to FRONTEND_URL/payment/result.
# VNPAY_RETURN_URL=

# --- MoMo (optional, BETA: not yet verified against a real MoMo account) ----
# MOMO_ENABLED=false
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
# Optional: defaults to FRONTEND_URL/payment/result.
# MOMO_RETURN_URL=
# Must be a public URL MoMo's servers can reach (use a tunnel in development).
# MOMO_IPN_URL=https://your-public-host/api/payments/momo/ipn

# --- Google sign-in (optional, off unless configured) -----------------------
# Never expose the service-account JSON to the web app.
# (GOOGLE_APPLICATION_CREDENTIALS pointing at the JSON file works too.)
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
